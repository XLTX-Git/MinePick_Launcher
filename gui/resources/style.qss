/* MinePick Launcher 鈥?dark theme
 *
 * This sheet holds no colour literals: every colour is a token placeholder resolved by gui/theme.py
 * (NEUTRAL_TOKENS + accent_palette), so one token carries a value per theme and the palette
 * lives in exactly one place. See MinePick_UI_瀹炵幇瑙勮寖.md 搂2.7.
 * Unresolved placeholders are caught by tests/test_qss_tokens.py.
 *
 * Kept from the released theme on purpose (do not regress):
 *   - tabs are flat: no background block, no radius, text + green underline only
 *   - scrollbars stay invisible; the wheel still scrolls
 *   - focus outlines are suppressed (code-side delegate + QSS outline: none)
 *   - combo arrow / checkbox tick use PNG placeholders substituted in theme.py
 */

QMainWindow, QDialog { background: __BG_WINDOW__; }

QWidget {
    color: __FG_TEXT__;
    font-family: __FONT__;
    font-size: 13px;
}

/* ---------- text roles ---------- */

QLabel#hint { color: __FG_HINT__; }
QLabel#warning { color: __DANGER_FG__; }
QLabel#title { font-size: 18px; font-weight: 700; }

/* ---------- panels: lists, tables, log views ---------- */

QListWidget, QTableWidget, QTableView, QPlainTextEdit, QTextEdit {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_LG__;
    padding: 4px;
    selection-background-color: __ACCENT_SEL__;
    selection-color: __FG_SELECTED__;
}

/* monospace only for log-like views: a plain text box (device code, notes) keeps the UI font */
QPlainTextEdit {
    font-family: "Cascadia Mono", Consolas, "Microsoft YaHei UI", monospace;
    font-size: 12px;
    padding: 8px 8px;
}
QTextEdit { padding: 4px 8px; }

/* ---------- inputs ---------- */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_SM__;
    padding: 4px 12px;
    min-height: 24px;
    selection-background-color: __ACCENT_SEL__;
    selection-color: __FG_SELECTED__;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: __BORDER_HOVER__; }

/* Placeholder text: Qt derives it from the widget's text colour at 50% alpha, and the `color` rule above
   overwrites the palette's PlaceholderText role on every input, so the painted placeholder belonged to
   no token in the theme. The Qt 6 property pins it to the same FG_HINT the light sheet uses (the
   secondary-text colour); the disabled field steps down to FG_DISABLED, one step lighter than the
   FG_DISABLED_2 its value is painted in, so the two roles stay apart. */
QLineEdit { placeholder-text-color: __FG_HINT__; }
QComboBox { placeholder-text-color: __FG_HINT__; }
/* the editor inside an editable combo is its own QLineEdit */
QComboBox QLineEdit { placeholder-text-color: __FG_HINT__; }
QLineEdit:disabled, QComboBox:disabled { placeholder-text-color: __FG_DISABLED__; }
/* Focus visuals live in one place: the [keyboardFocus="true"] block at the end of this sheet.
   The rules that used to sit here were plain :focus, so clicking an input with the mouse
   painted a ring - the rule is that nothing shows focus unless it came from Tab, the arrow
   keys or assistive navigation. */
/* Containers that can hold focus need a visible focus state of their own (UI guideline 5.1). They
   keep a 1px transparent border even at rest, so colouring it cannot shift the layout (3.3). */
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: __FG_DISABLED_2__;
    background: __BG_DISABLED__;
}

/* ---------- tables ---------- */

QTableWidget, QTableView { gridline-color: __BORDER_TABLE__; }

QHeaderView::section {
    background: __BG_SECTION__;
    color: __FG_HINT__;
    border: none;
    border-bottom: 1px solid __BORDER_LIST__;
    padding: 8px;
    font-weight: 400;
}
/* Header corners stay square: rounding a section exposed the base style's light
   default background in the clipped notch (light-grey wedges at both top corners). */
QHeaderView { background: __BG_SECTION__; }
QTableCornerButton::section { background: __BG_SECTION__; border: none; }

QTableWidget::item, QTableView::item { padding: 8px 8px; border: none; }
QTableWidget::item:hover, QTableView::item:hover { background: __BG_HOVER__; }
QTableWidget::item:selected, QTableView::item:selected {
    background: __ACCENT_SEL__;
    color: __FG_SELECTED__;
    outline: none;
}

/* ---------- buttons ---------- */

/* White text sits on the readable fill (AA contrast), the pure accent stays for borders.

   The transparent border is the focus ring's placeholder, the same shape the checkbox and the sidebar
   rail already use: it is always there, so colouring it cannot change the layout, the size hint or a
   single unfocused pixel - measured against the previous `border: none; padding: 8px 16px`, this rule
   renders the same button byte for byte (tools/button_state_hashes.py makes that a two-run diff).

   `padding: 4px 12px` is the compensation, not a design change: padding sits inside the border, so
   border + padding adds up to what padding alone used to (4+4 = 8, 4+12 = 16) and the text and the
   fill stay exactly where they were. Both numbers also sit on the spacing ladder the audit checks - a
   compensating `6px 14px` would have been off it and failed that gate. */
QPushButton {
    background: __ACCENT_BUTTON__;
    color: __FG_SELECTED__;
    border: 4px solid transparent;
    border-radius: __RADIUS_SM__;
    padding: 4px 12px;
    font-weight: 400;
}
QPushButton:hover { background: __ACCENT_BUTTON_HOVER__; }
QPushButton:pressed { background: __ACCENT_BUTTON_PRESS__; }
QPushButton:disabled { background: __BG_DISABLED_2__; color: __FG_DISABLED__; }
QPushButton:focus { outline: none; }

/* A focused filled button shows a ring, not just a slightly different green. It used to show only
   `background: __ACCENT_HOVER__` - measured 1.18:1 against the unfocused fill, which is a colour
   change the eye cannot resolve (WCAG 1.4.11 wants 3:1 for the indicator).

   The ring is drawn in __FG_SELECTED__, the one token the theme guarantees against this fill: the
   fill is `readable_fill(accent)`, i.e. the shade chosen so this foreground clears 4.5:1 on it, which
   holds for every accent preset in both themes (measured worst case 4.50:1). __FOCUS_RING__ cannot do
   this job here and the numbers say so: in the light theme FOCUS_RING *is* ACCENT_BUTTON - a ring in
   it is 1.00:1 against the fill it encloses, i.e. invisible by construction - and in the dark theme
   the pure accent is darker than its own readable fill, 1.37:1. FOCUS_RING stays what it is for the
   surfaces it was paired with (inputs, lists, the rail), where it measures 3:1 or better.

   The placeholder is 4px rather than 2px because the compensation has to land on the spacing ladder
   (4+4 = 8, 4+12 = 16); 2px would have needed the off-ladder `6px 14px`. The visible ring is the full
   4px, i.e. twice the 2px the task asks for, and a ring drawn *inside* the button is the construct
   Qt's stylesheet engine supports - `outline` and `outline-offset` are parsed and then ignored. */
QPushButton[keyboardFocus="true"] {
    background: __ACCENT_HOVER__;
    border-color: __FG_SELECTED__;
}

/* The default button of a dialog: the one Enter activates. Qt reports the standard `:default`
   pseudo-state for the *other* buttons in this build (measured: `QPushButton:default` matched the
   non-default button and never the default one), and QMessageBox does not paint a Fusion default
   indicator once a stylesheet sets the fill - which is how the quit confirmation ended up with two
   pixel-identical buttons. So the dialog marks its own default button with this property and the
   sheet draws the same ring the keyboard focus cue uses: one visual language, and the marker cannot
   drift onto a button nobody chose. Non-default buttons have no `defaultChoice` property and are
   untouched, byte for byte (tests/test_button_states.py pins both directions). */
QPushButton[defaultChoice="true"] { border-color: __FG_SELECTED__; }
/* Disabled wins over both: a dead button must not advertise itself as the default choice. */
QPushButton[defaultChoice="true"]:disabled,
QPushButton[keyboardFocus="true"]:disabled { border-color: transparent; }

/* ---------- button variants: default = primary, plus secondary and danger ---------- */

/* These two keep their original 1px border and their original padding: measured, a wider border here
   repainted 310 pixels of the unfocused button (worst channel delta 52-94, against a measured noise
   floor of 0), so a thicker ring was not worth it. Declaring the padding explicitly is what holds their
   pre-change size now that the base rule's padding pays for its own border. Their focus cue is the
   border colour - FOCUS_RING on a transparent surface, which is what these were always paired with -
   and it stays exactly as visible as it was. */
QPushButton#secondaryButton {
    background: transparent;
    color: __FG_BUTTON_SECONDARY__;
    border: 1px solid __BORDER_BUTTON_SECONDARY__;
    padding: 8px 16px;
    font-weight: 400;
}
QPushButton#secondaryButton:hover {
    background: __BG_BUTTON_SECONDARY__;
    border-color: __ACCENT__;
    color: __FG_TEXT__;
}
QPushButton#secondaryButton:pressed { background: __BG_BUTTON_PRESSED__; }
QPushButton#secondaryButton:disabled {
    background: transparent;
    color: __FG_DISABLED__;
    border-color: __BORDER_BUTTON_SECONDARY_2__;
}

QPushButton#dangerButton {
    background: transparent;
    color: __DANGER_FG__;
    border: 1px solid __DANGER_BORDER__;
    padding: 8px 16px;
    font-weight: 400;
}
QPushButton#dangerButton:hover { background: __DANGER_BG__; border-color: __DANGER_BORDER_2__; }
QPushButton#dangerButton:pressed { background: __DANGER_BG_2__; }
QPushButton#dangerButton:disabled {
    background: transparent;
    color: __DANGER_FG_2__;
    border-color: __DANGER_BORDER_3__;
}

/* Warning variant: the primary action of a warning reads in the warning colour, the way the danger
   variant already reads in the danger one. It keeps the variant box exactly (1px border, 8/16 padding,
   both on the spacing ladder) so the three variants cannot drift apart. Used by the in-window dialogs
   (gui/inwindow_dialog.py): "the launcher is warning you" must not look like an ordinary confirmation.
   Measured on the card it sits on (BG_LIST): 9.81:1 dark, 5.16:1 light - both clear 4.5:1. */
QPushButton#warningButton {
    background: transparent;
    color: __FG_STATUS_WARNING__;
    border: 1px solid __FG_STATUS_WARNING__;
    padding: 8px 16px;
    font-weight: 400;
}
QPushButton#warningButton:hover { background: __BG_BUTTON_SECONDARY__; }
QPushButton#warningButton:pressed { background: __BG_BUTTON_PRESSED__; }
QPushButton#warningButton:disabled {
    background: transparent;
    color: __FG_DISABLED__;
    border-color: __BORDER_BUTTON_SECONDARY_2__;
}
/* A warning button chosen as a dialog's default: the ring has to be the one the outlined variants use,
   because FG_SELECTED (the filled button's ring) is white on white in the light theme. */
QPushButton#dangerButton[defaultChoice="true"],
QPushButton#warningButton[defaultChoice="true"] { border-color: __FOCUS_RING__; }

/* ---------- status text severity ---------- */

QLabel#statusWarning { color: __FG_STATUS_WARNING__; }
QLabel#statusError { color: __DANGER_FG__; }

/* ---------- accent colour swatch in settings (outline follows the theme) ---------- */

QLabel#accentSwatch { border: 1px solid __BORDER_SWATCH__; border-radius: 5px; }

/* ---------- list items (generic) ---------- */

QListWidget::item { padding: 8px 12px; border-radius: __RADIUS_SM__; margin: 0 0; }
QListWidget::item:hover { background: __BG_HOVER__; }
QListWidget::item:selected,
QListWidget::item:selected:focus,
QListWidget::item:selected:!focus { background: __ACCENT_SEL__; color: __ACCENT_SEL_TEXT__; outline: none; }

/* ---------- sidebar navigation rail ---------- */

QListWidget#sidebar {
    background: transparent;
    border: 1px solid transparent;
    padding: 4px 4px;
    outline: none;
}
/* Gated on keyboardFocus (set by gui.widgets.KeyboardFocusTracker) so the ring appears when the
   user is navigating by keyboard, not merely because this widget happens to hold focus - the rail
   is first in the tab order and therefore focused on startup, which painted a ring nobody asked
   for. The rail itself carries the keyboard focus cue: Qt repaints a view's own border on focus, while the
   selected item's pseudo-state `:focus` proved unreliable for list items. */
QListWidget#sidebar[keyboardFocus="true"]:focus {
    border-color: __FOCUS_RING__;
}
QListWidget#sidebar::item {
    color: __FG_HINT__;
    /* 24px icon + 10px gap; 4px side padding leaves room for the longest Russian label. */
    padding: 4px 4px;
    margin: 4px 4px;
    border-radius: __RADIUS_LG__;
    border-left: 3px solid transparent;
    font-weight: 400;
}
QListWidget#sidebar::item:hover { background: __BG_SIDEBAR__; color: __FG_TEXT__; }
/* Selected pill: rounded on both sides so the shape stays symmetric. */
QListWidget#sidebar::item:selected {
    background: __ACCENT_SOFT__;
    color: __FG_SELECTED__;
    border-left: 3px solid __ACCENT__;
    border-radius: __RADIUS_LG__;
    font-weight: 400;
}

/* ---------- progress ---------- */

/* The percentage is not painted by Qt inside the bar. The chunk grows from the left, so a centred value
   ends up on the accent fill for most of a download, where FG_HINT measures 1.26:1 in this theme
   (light: 1.93:1) - and no single colour can clear AA on both halves at once, more so because the
   accent is user-chosen. It sits in its own label to the right instead (gui/widgets.py
   build_download_progress), on the static fill the bar itself uses: FG_HINT on BG_LIST is 6.48:1 in
   both themes and cannot be reached by an accent. Zero spacing between the two, and the outline is
   split across them, so the pair still reads as one control. */
QProgressBar {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LIST__;
    border-top-left-radius: __RADIUS_LG__;
    border-bottom-left-radius: __RADIUS_LG__;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    height: 16px;
    text-align: center;
    color: __FG_HINT__;
    font-size: 11px;
}
/* The fill is a plain rectangle on purpose. It used to carry `border-radius: 7px` of its own, which is
   not the frame's inner curve and cannot be: the frame's outer radius is RADIUS_LG (8px), so its groove
   is a 7px curve inset by the 1px border, while the chunk is a *rectangle* the width of the value. An
   independent radius on it therefore stops matching the frame as the value moves, and the two surfaces
   disagree at both ends - measured on the real platform (tools/measure_progress_corners.py, confirmed
   by an independent harness):
     * left end: the chunk's own curve sits inside the frame's, so the fill's left edge is not straight.
       Measured at 500/1000, the first fill pixel is at x=1 on the middle rows but at x=6 on the top row;
       the profile is the same at 100% (measured identically at 50/1000 and 1000/1000), so the fill's
       left end never settles into one shape while a download runs.
     * right end: the fill finishes in a bevel instead of a straight edge - the last row puts it five
       columns left of the middle rows (at 1000/1000: x=449 in the outermost measured row against x=451
       in the middle) - so the fill's right edge changes shape from 100% to 99.9%.
   Square, the chunk's geometry is the frame's geometry at every value: the frame draws the only corner
   the control has, and the fill is a straight edge inside it (at 100% its right edge reaches x=451, the
   frame's inner edge, one pixel short of the control's 452px outline). Same pixels at 0% and at 5% up to
   the fill's edge, and the same rule for every value in between. See tests/test_progress_shape.py. */
QProgressBar::chunk { background: __ACCENT__; }
/* The bar's own fill and the right half of its outline: one control, two segments. */
QLabel#downloadProgressText, QLabel#updateProgressText {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LIST__;
    border-left: none;
    border-top-right-radius: __RADIUS_LG__;
    border-bottom-right-radius: __RADIUS_LG__;
    color: __FG_HINT__;
    font-size: 11px;
}

/* ---------- checkboxes ---------- */

/* The 1px transparent border is the focus ring's placeholder, the same shape QListWidget#sidebar uses:
   the border is always 1px wide, so colouring it cannot change the layout or the size hint. Without a
   rule here a focused checkbox looked identical to an unfocused one - the walkthrough found every
   checkbox on the settings and instance pages in that state once it started enumerating all stops. */
QCheckBox { spacing: 8px; border: 1px solid transparent; }
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid __BORDER_HOVER__;
    border-radius: __RADIUS_XS__;
    background: __BG_LIST__;
}
QCheckBox::indicator:hover { border-color: __ACCENT__; }
QCheckBox::indicator:checked {
    background: __ACCENT__;
    border-color: __ACCENT__;
    image: url(__CHECK__);
}
QCheckBox::indicator:checked:hover { background: __ACCENT_HOVER__; border-color: __ACCENT_HOVER__; }

/* ---------- radio buttons ---------- */

/* Same construction as the checkbox, so the accessible-name gate and the focus ring work the same
   way: the 1px transparent border is the ring's placeholder and the indicator is 16x16 in both
   states. A checked radio is a filled accent disc - the only shape a QSS-only radio can draw
   without an extra image asset. Auto-exclusive siblings: each answer is a Tab stop, and the arrow
   keys move between the three. */
QRadioButton { spacing: 8px; border: 1px solid transparent; }
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid __BORDER_HOVER__;
    border-radius: 8px;
    background: __BG_LIST__;
}
QRadioButton::indicator:hover { border-color: __ACCENT__; }
QRadioButton::indicator:checked { background: __ACCENT__; border-color: __ACCENT__; }

/* ---------- status bar ---------- */

QStatusBar { background: __BG_WINDOW__; color: __FG_HINT__; border-top: 1px solid __BORDER_LIST__; }
QStatusBar::item { border: none; }

/* ---------- tabs: flat, text + green underline only ---------- */

QTabWidget { background: __BG_WINDOW__; }
QTabWidget::pane {
    border: none;
    border-radius: 0px;
    background: __BG_WINDOW__;
}
QTabBar { background: transparent; }
QTabBar::tab {
    background: transparent;
    color: __FG_HINT__;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover { color: __FG_TEXT__; }
QTabBar::tab:selected {
    color: __FG_SELECTED__;
    background: transparent;
    border-bottom: 2px solid __ACCENT__;
}

/* ---------- combo popup ---------- */

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}
/* Lucide chevron-down at 16px, no box: one SVG per state because a QSS image cannot be tinted.
   The focus state is gated on [keyboardFocus="true"], like every other focus cue in this sheet. */
QComboBox::down-arrow {
    image: url(__CHEVRON_DOWN__);
    width: 16px;
    height: 16px;
    margin-right: 8px;
}
/* The state comes from a dynamic property, not :hover / :disabled: Qt 6.11 applies those two in front
   of a subcontrol to every combo (see gui/widgets.py:ComboArrowState for the measured behaviour). */
QComboBox[comboHover="true"]::down-arrow,
QComboBox[keyboardFocus="true"]::down-arrow {
    image: url(__CHEVRON_DOWN_ACTIVE__);
}
QComboBox[comboDisabled="true"]::down-arrow {
    image: url(__CHEVRON_DOWN_DISABLED__);
}
/* The popup is its own top-level window (QComboBoxPrivateContainer, a Qt::Popup). gui/popup_shape.py
   makes that window translucent and frameless (keeping Qt::Popup, which is what closes it on an
   outside click), clears the container's own frame, names the list comboPopupList and leaves Qt's
   placement (flush under the field, the popup's top border sharing the field's bottom border). The
   list below is then the only surface, so the pixels outside its 1px BORDER_LIST outline show the
   page behind instead of a square window patch. The selector names the list explicitly as well as
   through the combo descendant chain: the class form is what Qt's listbox popup uses, and the id
   form survives any future wrapper between the combo and its view. The 4px list padding keeps the
   viewport's square corners inside that outline. */
QComboBox QAbstractItemView,
QListView#comboPopupList {
    /* The field's own outlined language, not a floating card: same BG_LIST fill, same 1px
       BORDER_LIST, square corners, and the window sits flush under the field so the two outlines
       read as one control extending downwards. Fill and radius/border live in this single rule:
       Qt only rounds a fill painted by the rule that also declares the radius. */
    background: __BG_LIST__;
    color: __FG_TEXT__;
    border: 1px solid __BORDER_LIST__;
    /* The popup's top edge sits on the field's bottom border: leaving the top border off makes the
       field's own line the seam, so the two read as one control instead of a 2px double rule. */
    border-top: none;
    border-radius: 0;
    /* No panel padding: the first row and its highlight start at the field's border, like PCL's
       menu. The 8px 12px item padding still insets the text. */
    padding: 0;
    selection-background-color: __ACCENT_SEL_ROW__;
    selection-color: __FG_TEXT__;
    outline: none;
}
QComboBox QAbstractItemView::item,
QListView#comboPopupList::item {
    padding: 8px 12px;
    min-height: 26px;
    border-radius: 0;
}
/* The one highlighted row: ACCENT_SEL_ROW is a per-theme derivation of ACCENT_SEL (light uses it
   as is; dark blends 60% of it toward BG_LIST), so the current entry is visibly marked without a
   saturated block competing with the field. Hover uses the next surface token for pointer feedback;
   the selected rule comes last so it wins when both states apply. */
QComboBox QAbstractItemView::item:hover,
QListView#comboPopupList::item:hover {
    background: __BG_SECTION__;
}
QComboBox QAbstractItemView::item:selected,
QListView#comboPopupList::item:selected {
    background: __ACCENT_SEL_ROW__;
    color: __FG_TEXT__;
}

/* Sliders: flat 4px track, accent on the filled side, 16px round handle. Every subcontrol is styled on
   purpose: an unstyled groove / add-page / handle falls back to the platform's sunken groove, which is
   the 3D bar the user reported in the light theme. This sheet had no slider rules at all before, so the
   settings memory slider and the wizard slider were both native here. The geometry is the light sheet's
   (16px groove carrying a 4px band, 16px handle at margin 0 - the handle moves inside the groove's
   contents rect, so a bare 4px groove would clip it, and a negative margin would fail the spacing audit);
   only the values differ - dark is asked to be flat, not re-tuned. */
QSlider::groove:horizontal {
    height: 16px;
    border: none;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0.375 transparent,
        stop: 0.39 __BORDER_LIST__,
        stop: 0.61 __BORDER_LIST__,
        stop: 0.625 transparent
    );
}
QSlider::sub-page:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0.375 transparent,
        stop: 0.39 __ACCENT_BUTTON__,
        stop: 0.61 __ACCENT_BUTTON__,
        stop: 0.625 transparent
    );
}
QSlider::add-page:horizontal {
    background: transparent;
}
QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: 0;
    border-radius: 8px;
    background: __BG_LIST_2__;
    border: 2px solid __ACCENT_BUTTON__;
}
QSlider::handle:horizontal:hover {
    background: __BG_HOVER__;
}
QSlider::groove:horizontal:disabled {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0.375 transparent,
        stop: 0.39 __BG_DISABLED_2__,
        stop: 0.61 __BG_DISABLED_2__,
        stop: 0.625 transparent
    );
}
QSlider::sub-page:horizontal:disabled {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0.375 transparent,
        stop: 0.39 __BG_DISABLED_2__,
        stop: 0.61 __BG_DISABLED_2__,
        stop: 0.625 transparent
    );
}
QSlider::handle:horizontal:disabled {
    border-color: __BORDER_LIST__;
    background: __BG_DISABLED__;
}
QSlider[keyboardFocus="true"]:focus::handle:horizontal {
    border-color: __FOCUS_RING__;
    background: __ACCENT_SOFT__;
}

/* ---------- menus and tooltips ---------- */

QMenu {
    background: __BG_LIST_2__;
    color: __FG_TEXT__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_LG__;
    padding: 4px;
}
QMenu::item { padding: 8px 24px; border-radius: __RADIUS_SM__; }
QMenu::item:selected { background: __ACCENT_SEL__; color: __ACCENT_SEL_TEXT__; }
QMenu::separator { height: 1px; background: __BG_SEPARATOR__; margin: 4px 8px; }
QToolTip {
    background: __BG_LIST_2__;
    color: __FG_TEXT__;
    border: 1px solid __BORDER_HOVER__;
    border-radius: __RADIUS_SM__;
    padding: 4px 8px;
}
/* Our own tooltip bubble (WCAG 1.4.13): a tool window that accepts the pointer, so it has to look
   exactly like the native bubble it replaces. Its spacing lives in the layout, not here. */
QWidget#tooltipLayer {
    background: __BG_LIST_2__;
    color: __FG_TEXT__;
    border: 1px solid __BORDER_HOVER__;
    border-radius: __RADIUS_SM__;
}

/* ---------- spin box: no up/down buttons ---------- */

/* Hide the two sub-controls but keep QSpinBox: typing and the Up/Down keys still change the value
   (the keyboard path is the widget's own, not the buttons'), and NoWheelSpinBox keeps the wheel
   behaviour unchanged. The 12px right padding is the room the text needs without the buttons. */
QSpinBox, QDoubleSpinBox {
    padding-right: 12px;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
}



/* ---------- scrollbars: invisible until the pointer enters the list, then a slim handle ---------- */

QScrollBar:vertical { background: transparent; width: 7px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 7px; margin: 0; }
/* No min-height / min-width here on purpose: those propagate into the scroll area's own
   minimum size and made the account page 17px taller than the 1000x600 window. */
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: transparent;
    border: none;
    border-radius: 3px;
}
QScrollBar[active="true"]::handle:vertical,
QScrollBar[active="true"]::handle:horizontal { background: __BG_SCROLLBAR__; }
QScrollBar[active="true"]::handle:vertical:hover,
QScrollBar[active="true"]::handle:horizontal:hover { background: __ACCENT__; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; background: transparent; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- scroll area keeps the page background ---------- */

QScrollArea { background: transparent; border: 1px solid transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }

/* ---------- grouped form sections ---------- */

QGroupBox {
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_LG__;
    margin-top: 12px;
    padding: 12px 12px 12px 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: __FG_HINT__;
    font-weight: 400;
}

/* ---------- versions page: category chips + latest cards ---------- */

QPushButton#categoryTab {
    background: transparent;
    color: __FG_HINT__;
    border: 1px solid transparent;
    border-radius: 15px;
    padding: 8px 16px;
    font-weight: 400;
}
QPushButton#categoryTab:hover { color: __FG_TEXT__; background: __BG_SIDEBAR__; border-radius: 15px; }
QPushButton#categoryTab:checked {
    background: __ACCENT_BUTTON__;
    color: __FG_SELECTED__;
    border-color: __ACCENT_BUTTON__;
    border-radius: 15px;
    font-weight: 400;
}

/* Keyboard focus must survive the id rule: `QPushButton:focus` loses to `QPushButton#categoryTab`.
   The base rule already has `border: 1px solid transparent`, so colouring it shifts no layout, and
   this rule stays distinguishable from the checked state (which fills the pill). */
QPushButton#categoryTab[keyboardFocus="true"]:focus {
    border-color: __FOCUS_RING__;
    color: __FG_TEXT__;
}

/* The latest-version cards are white cards like every other card on the paper: the accent border
   this used to carry was the only place the accent framed something that is not a control. */
QFrame#latestCard {
    background: __BG_LIST__;
    border: 1px solid __BORDER_TABLE__;
    border-radius: __RADIUS_LG__;
}
QLabel#latestKind { color: __FG_HINT__; font-size: 12px; }
QLabel#latestVersion { font-size: 15px; font-weight: 600; color: __FG_CARD_LATEST__; }

/* ---------- versions page: dense version cards ---------- */
/* The list itself paints nothing: every row is its own card (painted in code, like the resource
   rows), so the page shows through the 8px gap between two cards. */

QWidget#versionsPage QLineEdit {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LAUNCH_FIELD__;
    border-radius: __RADIUS_SM__;
    padding: 0 12px;
    font-size: 13px;
}
QWidget#versionsPage QLineEdit:hover { border-color: __BORDER_HOVER__; }
QWidget#versionsPage QLineEdit[keyboardFocus="true"] { border-color: __FOCUS_RING__; }

QListWidget#versionList {
    background: transparent;
    border: 1px solid transparent;
    padding: 0;
    outline: none;
}
QListWidget#versionList::item {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}
QListWidget#versionList[keyboardFocus="true"] { border-color: __FOCUS_RING__; }

/* ---------- versions page: the install step (instance name + loader choice) ---------- */
/* The list is replaced by this step (not covered by a window): one breadcrumb card, one row per
   loader, one pill button. The loader rows paint their own surface in code, like the version rows
   above; the rule below exists for the focus contract the keyboard walkthrough reads, and the row
   paints the same ring from the same property. */

QFrame#installBreadcrumb {
    background: __BG_LIST__;
    border: 1px solid __BORDER_TABLE__;
    border-radius: __RADIUS_LG__;
}
QWidget#versionsPage QLabel#installFixedName {
    color: __FG_TEXT__;
    font-size: 15px;
    font-weight: 600;
    padding: 0 12px;
}
QWidget#versionsPage QLabel#installNameHint { color: __FG_HINT__; font-size: 12px; }
QWidget#versionsPage QLabel#installNameHint[error="true"] { color: __DANGER_FG__; }
QWidget#versionsPage QLabel#installStepHint { color: __FG_HINT__; font-size: 12px; }
QWidget#versionsPage QLabel#installFieldLabel { color: __FG_HINT__; font-size: 12px; }
QWidget#versionsPage QLineEdit[invalid="true"] {
    border-color: __DANGER_FG__;
    color: __DANGER_FG__;
}

/* The one primary action of the step: a centred pill, 48px tall, fully rounded. */
QPushButton#installPrimary {
    background: __ACCENT_BUTTON__;
    color: __FG_SELECTED__;
    border: 1px solid transparent;
    border-radius: 24px;
    padding: 0 24px;
    font-size: 15px;
    font-weight: 600;
}
QPushButton#installPrimary:hover { background: __ACCENT_BUTTON_HOVER__; }
QPushButton#installPrimary:pressed { background: __ACCENT_BUTTON_PRESS__; }
QPushButton#installPrimary:disabled { background: __BG_DISABLED__; color: __FG_DISABLED__; }
QPushButton#installPrimary[keyboardFocus="true"] { border-color: __FOCUS_RING__; }

QAbstractButton#loaderChoiceRow[keyboardFocus="true"] { border: 1px solid __FOCUS_RING__; }

/* ---------- shared page cards (java / account) ---------- */
/* One white card holding a 15px section title and a list of dense rows. The rows paint their own
   hover/selection tint and the hairline between two of them; the card owns the surface. */

QFrame#pageCard {
    background: __BG_LIST__;
    border: 1px solid __BORDER_TABLE__;
    border-radius: __RADIUS_LG__;
}

/* A child scroll area must not paint its own square viewport over the card's rounded corner.
   The cards inset their lists today; this keeps a future flush child from bringing the square
   corner back, which is what tools/audit_card_radius.py reads pixel by pixel. */
QFrame#pageCard QAbstractScrollArea,
QFrame#pageCard QAbstractScrollArea > QWidget#qt_scrollarea_viewport,
QFrame#pageCard QWidget#qt_scrollarea_viewport,
QFrame#pageCard QListWidget,
QFrame#pageCard QTableWidget,
QFrame#pageCard QTableView,
QFrame#pageCard QTextEdit,
QFrame#pageCard QPlainTextEdit {
    background: transparent;
}

/* The step between the 20px page title and the 12px hint: one section heading inside a card. */
QLabel#sectionTitle { font-size: 15px; font-weight: 600; color: __FG_TEXT__; }
/* A form row's own label (no QFormLayout to pass it on): 13px, same colour as body text. */
QLabel#formLabel { font-size: 13px; color: __FG_TEXT__; }

QListWidget#javaManagedList, QListWidget#javaDetectedList {
    background: transparent;
    border: 1px solid transparent;
    padding: 0;
    outline: none;
}
QListWidget#javaManagedList::item, QListWidget#javaDetectedList::item {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}
QListWidget#javaManagedList[keyboardFocus="true"],
QListWidget#javaDetectedList[keyboardFocus="true"] {
    border-color: __FOCUS_RING__;
}

/* Row-level delete: the danger colour on a secondary button, sized like #rowInstall. */
QPushButton#rowDanger {
    background: transparent;
    color: __DANGER_FG__;
    border: 1px solid __DANGER_BORDER__;
    border-radius: __RADIUS_SM__;
    padding: 0 16px;
    font-size: 12px;
    font-weight: 400;
}
QPushButton#rowDanger:hover { background: __DANGER_BG__; border-color: __DANGER_BORDER_2__; }
QPushButton#rowDanger:pressed { background: __DANGER_BG_2__; }
QPushButton#rowDanger:disabled {
    color: __FG_DISABLED__;
    border-color: __BORDER_BUTTON_SECONDARY_2__;
}
QPushButton#rowDanger[keyboardFocus="true"]:focus { border-color: __FOCUS_RING__; }

/* ---------- account page: the account-list card ---------- */

QWidget#accountPage QLabel#hint { font-size: 12px; }

QListWidget#accountList {
    background: transparent;
    border: 1px solid transparent;
    padding: 0;
    outline: none;
}
QListWidget#accountList::item {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}
QListWidget#accountList[keyboardFocus="true"] { border-color: __FOCUS_RING__; }

/* Neutral row action (the account row's switch): the row button's shape, without the install name. */
QPushButton#rowAction {
    background: transparent;
    color: __FG_BUTTON_SECONDARY__;
    border: 1px solid __BORDER_BUTTON_SECONDARY__;
    border-radius: __RADIUS_SM__;
    padding: 0 16px;
    font-size: 12px;
    font-weight: 400;
}
QPushButton#rowAction:hover {
    background: __BG_BUTTON_SECONDARY__;
    border-color: __ACCENT__;
    color: __FG_TEXT__;
}
QPushButton#rowAction:pressed { background: __BG_BUTTON_PRESSED__; }
QPushButton#rowAction:disabled {
    color: __FG_DISABLED__;
    border-color: __BORDER_BUTTON_SECONDARY_2__;
}
QPushButton#rowAction[keyboardFocus="true"]:focus { border-color: __FOCUS_RING__; }

/* ---------- icon-only buttons (launch page: switch account) ---------- */

QPushButton#iconButton {
    background: transparent;
    border: 1px solid __BORDER_BUTTON_ICON__;
    border-radius: __RADIUS_SM__;
    padding: 4px;
}
QPushButton#iconButton:hover { background: __BG_BUTTON_ICON__; border-color: __ACCENT__; }
QPushButton#iconButton:pressed { background: __BG_BUTTON_PRESSED__; }
/* The button is borderless at rest, so the generic QPushButton:focus rule cannot show through: an
   id-scoped rule wins. The 1px border already exists at rest, so focusing shifts nothing. */
QPushButton#iconButton[keyboardFocus="true"]:focus { border: 1px solid __FOCUS_RING__; }

/* ---------- in-window overlay dialogs (crash diagnosis) ---------- */

/* The card is the one surface painted over a scrim rather than over the page, so its fill needs to
   separate it from the *dimmed* page. BG_LIST cannot: it measures 1.21:1 from the scrim, and 1.28:1
   is the ceiling for any scrim because that is BG_LIST against pure black - darkening the backdrop
   was not enough on its own. The fill is therefore the raised BG_OVERLAY_CARD (2.31:1 against the
   scrimmed page) and the outline only has to sit on that fill (BORDER_SWATCH would be 1.06:1 above
   it). The scrim's strength is per theme in gui/overlay.py SCRIM_ALPHA; the light sheet keeps its
   white card and its quiet BORDER_BUTTON_ICON edge. */
QWidget#overlayCard {
    background: __BG_OVERLAY_CARD__;
    border: 1px solid __BORDER_OVERLAY_CARD__;
    border-radius: __RADIUS_LG__;
}
QLabel#overlayCode {
    color: __FG_OVERLAY_CODE__;
    background: __BG_OVERLAY_CODE__;
    border: 1px solid __BORDER_OVERLAY_CODE__;
    border-radius: __RADIUS_SM__;
    padding: 0 8px;
    font-weight: 400;
}
QLabel#overlayBody { color: __FG_OVERLAY_BODY__; }
QScrollArea#overlayScroll { background: transparent; }

/* ---------- second-level heading + launch version block ---------- */

/* Top-level pages no longer draw a page name or description; the 16px top inset is a layout
   value (gui/widgets.add_page_top_inset). Two headings remain: the drilled-in instance-detail
   page keeps its back/title row, and the launch page's version number is data, not a page name.
   They share one 20px/12px type scale through their own object names. */
QLabel#instanceDetailTitle, QWidget#launchPage QLabel#launchVersionTitle {
    color: __FG_PAGE_TITLE__;
    font-size: 20px;
    font-weight: 600;
}
QLabel#instanceDetailHint, QWidget#launchPage QLabel#launchVersionMeta {
    color: __FG_HINT__;
    font-size: 12px;
}

/* ---------- sidebar brand ---------- */


/* ---------- empty state ---------- */

QLabel#emptyState {
    color: __FG_EMPTY_STATE__;
    font-size: 12px;
    padding: 16px 8px;
    background: transparent;
}

/* ---------- keyboard focus: only shown when navigating with the keyboard ---------- */

QListWidget[keyboardFocus="true"], QTableView[keyboardFocus="true"], QTableWidget[keyboardFocus="true"],
QPlainTextEdit[keyboardFocus="true"], QTextEdit[keyboardFocus="true"], QComboBox[keyboardFocus="true"],
QLineEdit[keyboardFocus="true"], QSpinBox[keyboardFocus="true"], QDoubleSpinBox[keyboardFocus="true"] {
    border: 1px solid __FOCUS_RING__;
}
QPushButton[keyboardFocus="true"] { background: __ACCENT_HOVER__; }
/* Variant buttons are outlined on transparent, not filled: FG_SELECTED would be white-on-white on the
   light sheet. Their focus cue stays the FOCUS_RING they were already paired with, which clears 3:1
   against the surfaces they sit on in both themes. Only the colour is set - the 1px width comes from
   their own rule, so this cannot shift anything. */
QPushButton#secondaryButton[keyboardFocus="true"], QPushButton#dangerButton[keyboardFocus="true"],
QPushButton#warningButton[keyboardFocus="true"] {
    border-color: __FOCUS_RING__;
}
QScrollArea[keyboardFocus="true"] { border: 1px solid __FOCUS_RING__; }
/* Checkboxes: the ring is the control's own 1px border, which sits at `1px solid transparent` in the
   checkbox section below, so colouring it cannot move anything. Gated on keyboardFocus like the rest, so
   a mouse click paints nothing. */
QCheckBox[keyboardFocus="true"]:focus {
    border-color: __FOCUS_RING__;
}
/* Radios: same placeholder border as the checkbox, so the keyboard ring costs no layout space. */
QRadioButton[keyboardFocus="true"]:focus {
    border-color: __FOCUS_RING__;
}
/* The resource tab widget is itself the focus stop (its tab bar is NoFocus and draws the tabs). Qt gives
   a styled QTabWidget a pane frame, so the ring belongs on QTabWidget::pane - colouring the widget's own
   border would draw a second rectangle next to the pane's. */
QTabWidget[keyboardFocus="true"]::pane {
    border: 1px solid __FOCUS_RING__;
}


/* ---------- custom title bar (frameless window) ---------- */

QWidget#titleBar {
    background: __BG_TOPBAR__;
    border-bottom: none;
}
QLabel#titleBarTitle { color: __FG_TOPBAR__; font-size: 13px; font-weight: 400; }

QPushButton#titleBarMinimize, QPushButton#titleBarClose {
    background: transparent;
    border: none;
    border-radius: __RADIUS_SM__;
    color: __FG_TOPBAR__;
    font-size: 13px;
    padding: 0;
}
QPushButton#titleBarMinimize:hover {
    background: __BG_TITLEBAR_MINIMIZE__;
    color: __FG_TOPBAR__;
}
QPushButton#titleBarClose:hover { background: __BG_TITLEBAR_CLOSE__; color: __FG_TOPBAR__; }

/* ---------- frameless window: chrome, paper and the navigation rail ---------- */

/* The same two explicit layers the light sheet uses, with this theme's values. appRoot is the
   window chrome; appContent and the page stack carry the page paper. The stack must paint it,
   not only the page widget: QStackedLayout lays its child out inside the stack's contents rect,
   so the 6/12/12/12 inset would otherwise show the chrome colour as a frame. */
QWidget#appRoot { background: __BG_WINDOW__; }
QWidget#appContent { background: __BG_PAGE__; }
QStackedWidget#pageStack { background: __BG_PAGE__; }

/* The rail shares the window chrome's level in dark (BG_NAV = BG_WINDOW), one step below the paper,
   so the cards stay the brightest surface and the rail recedes behind them. The 1px right border sits
   inside the rail's fixed 162px width, so no window layout moves. */
QWidget#navRail {
    background: __BG_NAV__;
    border-right: 1px solid __BORDER_NAV__;
}

/* Page-level scroll viewports paint the paper themselves; otherwise the viewport falls back to
   the platform Base and a white streak appears when a long page is scrolled to its end. */
QWidget#settingsPage QScrollArea > QWidget#qt_scrollarea_viewport,
QWidget#aboutPage QScrollArea > QWidget#qt_scrollarea_viewport,
QWidget#instanceDetail QScrollArea > QWidget#qt_scrollarea_viewport {
    background: __BG_PAGE__;
}

/* ========================================================================== */
/* Settings page: the same paper + card structure as the light sheet, in this  */
/* theme's palette. Only structure is aligned here - the dark colours above    */
/* are reused as-is (BG_PAGE / BG_LIST / BORDER_LAUNCH_FIELD / FG_TEXT).      */
/* ========================================================================== */

QWidget#settingsPage {
    background: __BG_PAGE__;
}

QWidget#settingsPage QWidget#settingsCard {
    background: __BG_LIST__;
    border: none;
    border-radius: __RADIUS_LG__;
}

/* 32px field in a 38px row (6px gutter), 6px radius, 1px border, 12px left padding, 15px text.
   The min-heights differ by control because Qt adds a different frame allowance: a plain
   QLineEdit/QComboBox needs 30 (30+2), a spin box already carries 4px of frame (28+4); both land
   on the 32px height the page measures. */
QWidget#settingsPage QLineEdit,
QWidget#settingsPage QComboBox,
QWidget#settingsPage QSpinBox,
QWidget#settingsPage QDoubleSpinBox {
    background: __BG_LIST__;
    color: __FG_TEXT__;
    border: 1px solid __BORDER_LAUNCH_FIELD__;
    border-radius: __RADIUS_SM__;
    padding: 0 12px;
    font-size: 15px;
    selection-background-color: __ACCENT_SEL__;
    selection-color: __ACCENT_SEL_TEXT__;
}
QWidget#settingsPage QLineEdit,
QWidget#settingsPage QComboBox {
    min-height: 30px;
}
QWidget#settingsPage QSpinBox,
QWidget#settingsPage QDoubleSpinBox {
    min-height: 28px;
}
/* A combo/spin box already draws its own frame; the internal editor must not draw a second one. */
QWidget#settingsPage QComboBox QLineEdit,
QWidget#settingsPage QSpinBox QLineEdit,
QWidget#settingsPage QDoubleSpinBox QLineEdit {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
}
QWidget#settingsPage QLineEdit:hover,
QWidget#settingsPage QComboBox:hover,
QWidget#settingsPage QSpinBox:hover,
QWidget#settingsPage QDoubleSpinBox:hover {
    border-color: __BORDER_HOVER__;
}
QWidget#settingsPage QLineEdit:disabled,
QWidget#settingsPage QComboBox:disabled,
QWidget#settingsPage QSpinBox:disabled,
QWidget#settingsPage QDoubleSpinBox:disabled {
    background: __BG_LAUNCH_FIELD_DISABLED__;
    color: __FG_DISABLED_2__;
    border-color: __BG_LAUNCH_FIELD_DISABLED__;
}
/* Keep the keyboard-only contract: id-scoped rules above would otherwise win over the generic
   [keyboardFocus="true"] ring at the end of the sheet. */
QWidget#settingsPage QLineEdit[keyboardFocus="true"]:focus,
QWidget#settingsPage QComboBox[keyboardFocus="true"]:focus,
QWidget#settingsPage QSpinBox[keyboardFocus="true"]:focus,
QWidget#settingsPage QDoubleSpinBox[keyboardFocus="true"]:focus {
    border: 1px solid __FOCUS_RING__;
}

/* The fixed label column: left aligned, never re-centred per row. 12px keeps wrapped long labels
   at two lines of 16px inside the 32px row. */
QWidget#settingsPage QLabel#settingsFieldLabel {
    color: __FG_TEXT__;
    font-size: 12px;
}
QWidget#settingsPage QLabel#hint {
    font-size: 12px;
}
QWidget#settingsPage QLabel#memoryValue {
    color: __FG_TEXT__;
    font-size: 15px;
    font-weight: 600;
    padding-left: 12px;
}
QWidget#settingsPage QLabel#memoryValue:disabled {
    color: __FG_DISABLED_2__;
}

/* Secondary buttons: card fill, one neutral outline, body label; the accent stays for the ring. */
QWidget#settingsPage QPushButton#secondaryButton {
    background: __BG_LIST__;
    color: __FG_TEXT__;
    border: 1px solid __BORDER_BUTTON_SECONDARY__;
    border-radius: __RADIUS_SM__;
    padding: 0 16px;
    min-height: 30px;
    font-weight: 400;
}
QWidget#settingsPage QPushButton#secondaryButton:hover {
    background: __BG_BUTTON_SECONDARY__;
    border-color: __BORDER_HOVER__;
    color: __FG_TEXT__;
}
QWidget#settingsPage QPushButton#secondaryButton:pressed {
    background: __BG_BUTTON_PRESSED__;
}
QWidget#settingsPage QPushButton#secondaryButton:disabled {
    background: __BG_LIST__;
    color: __FG_DISABLED__;
    border-color: __BORDER_BUTTON_SECONDARY_2__;
}
QWidget#settingsPage QPushButton#secondaryButton[keyboardFocus="true"] {
    background: __BG_LIST__;
    border-color: __FOCUS_RING__;
}
QWidget#settingsPage QPushButton#secondaryButton[keyboardFocus="true"]:disabled {
    border-color: __BORDER_BUTTON_SECONDARY_2__;
}

/* The accessibility QGroupBox is a quiet section: a hairline and a 16px heading, no framed card. */
QWidget#settingsPage QGroupBox {
    background: transparent;
    border: none;
    border-top: 1px solid __BG_SEPARATOR__;
    border-radius: 0;
    margin-top: 24px;
    padding: 16px 0 0 0;
}
QWidget#settingsPage QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    padding: 0 4px 12px 0;
    color: __FG_TEXT__;
    font-size: 16px;
    font-weight: 700;
}

/* ========================================================================== */
/* About page: the same shared #pageCard cards as the light sheet, with the   */
/* titles inside them. The about-specific group-box fill is gone: #pageCard   */
/* already carries this theme's card fill and border. No colour is added here. */
/* ========================================================================== */

QWidget#aboutPage QLabel#hint { font-size: 12px; }
QWidget#aboutPage QLabel#aboutLink { font-size: 12px; color: __FG_HINT__; }

/* ========================================================================== */
/* Launch page: the same paper + side-panel structure as the light sheet.     */
/* Scoped to #launchPage / #launchPanel; the right half stays blank paper.    */
/* ========================================================================== */

QWidget#launchPage {
    background: __BG_PAGE__;
}

/* 360px wide (set in code) and inset 16px by the page layout: a white card floating on the paper,
   rounded on all four corners like every other card, instead of a strip welded to the window edge. */
QWidget#launchPage QWidget#launchPanel {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_LG__;
}

QWidget#launchPage QLabel#accountName {
    color: __FG_LAUNCH__;
    font-size: 14px;
    font-weight: 400;
}
QWidget#launchPage QLabel#launchStats,
QWidget#launchPage QLabel#launchLast {
    color: __FG_LAUNCH_HINT__;
    font-size: 11px;
}

/* Inline account switch (24px, on the name row): a quiet icon, not a second row. */
QWidget#launchPage QPushButton#iconButton[accountSwitch="true"] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 0;
}
QWidget#launchPage QPushButton#iconButton[accountSwitch="true"]:hover {
    background: __BG_HOVER__;
    border-color: transparent;
}
QWidget#launchPage QPushButton#iconButton[accountSwitch="true"]:pressed {
    background: __BG_BUTTON_PRESSED__;
}
QWidget#launchPage QPushButton#iconButton[accountSwitch="true"][keyboardFocus="true"] {
    border-color: __FOCUS_RING__;
}

QWidget#launchPage QPushButton#launchButton {
    padding: 0;
}
QWidget#launchPage QPushButton#launchButton QLabel#launchActionTitle {
    background: transparent;
    color: __FG_SELECTED__;
    font-size: 16px;
    font-weight: 700;
}

/* Two equal secondary actions: card face, 1px neutral border, body label. 12px type and 8px side
   padding keep the longest German/Russian label on one line inside a 154px half. */
QWidget#launchPage QPushButton#secondaryButton {
    background: __BG_LIST__;
    color: __FG_LAUNCH__;
    border: 1px solid __BORDER_LAUNCH_FIELD__;
    padding: 8px 8px;
    font-size: 12px;
    font-weight: 400;
}
QWidget#launchPage QPushButton#secondaryButton:hover {
    background: __BG_HOVER__;
    border-color: __ACCENT__;
    color: __FG_LAUNCH__;
}
QWidget#launchPage QPushButton#secondaryButton:pressed {
    background: __BG_BUTTON_PRESSED__;
}
QWidget#launchPage QPushButton#secondaryButton:disabled {
    background: __BG_LIST__;
    color: __FG_DISABLED__;
    border-color: __BORDER_BUTTON_SECONDARY_2__;
}
QWidget#launchPage QPushButton#secondaryButton[keyboardFocus="true"]:disabled {
    border-color: __BORDER_BUTTON_SECONDARY_2__;
}
QWidget#launchPage QPushButton#secondaryButton[keyboardFocus="true"] {
    border-color: __FOCUS_RING__;
}

/* Advanced disclosure: a secondary button that reads as a quiet text row. */
QWidget#launchPage QPushButton#secondaryButton[disclosure="true"] {
    background: transparent;
    border-color: transparent;
    color: __FG_LAUNCH_HINT__;
    padding: 4px 8px;
    text-align: left;
    font-size: 13px;
    font-weight: 400;
}
QWidget#launchPage QPushButton#secondaryButton[disclosure="true"]:hover {
    background: __BG_HOVER__;
    border-color: transparent;
    color: __FG_LAUNCH__;
}
QWidget#launchPage QPushButton#secondaryButton[disclosure="true"]:pressed {
    background: __BG_BUTTON_PRESSED__;
}
QWidget#launchPage QPushButton#secondaryButton[disclosure="true"]:checked {
    color: __FG_LAUNCH__;
}
QWidget#launchPage QPushButton#secondaryButton[disclosure="true"][keyboardFocus="true"] {
    border-color: __FOCUS_RING__;
}

/* 40px field, 6px radius, 1px border, 12px left padding, 15px text. */
QWidget#launchPage QLineEdit {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LAUNCH_FIELD__;
    border-radius: __RADIUS_SM__;
    padding: 0 12px;
    min-height: 38px;
    color: __FG_LAUNCH__;
    font-size: 15px;
    selection-background-color: __ACCENT_SEL__;
    selection-color: __ACCENT_SEL_TEXT__;
}
QWidget#launchPage QLineEdit:hover {
    border-color: __BORDER_HOVER__;
}
QWidget#launchPage QLineEdit:disabled {
    background: __BG_LAUNCH_FIELD_DISABLED__;
    color: __FG_DISABLED__;
}
QWidget#launchPage QLineEdit[keyboardFocus="true"] {
    border-color: __FOCUS_RING__;
}
QWidget#launchPage QLabel#fieldLabel {
    color: __FG_LAUNCH_HINT__;
    font-size: 12px;
}

/* ---------- first-run wizard overlay ---------- */

QWidget#wizardOverlay { background: __BG_WINDOW__; }
QWidget#wizardCard {
    background: __BG_WINDOW__;
    border: none;
    border-radius: 0;
}
QLabel#wizardHeading { font-size: 19px; font-weight: 700; color: __FG_PAGE_TITLE__; }
QLabel#wizardHeadingBig { font-size: 26px; font-weight: 700; color: __FG_PAGE_TITLE__; }
QLabel#wizardDescription { color: __FG_HINT__; font-size: 13px; }
QLabel#wizardDot { background: __BG_RAIL_DOT__; border-radius: 4px; }
QLabel#wizardDot[current="true"] { background: __ACCENT__; }

/* ---------- wizard: rail, action bar, bigger buttons ---------- */

QWidget#wizardRail { background: __BG_WINDOW__; border-right: 1px solid __BORDER_LIST__; }
QLabel#wizardRailItem { color: __FG_RAIL_ITEM__; font-size: 13px; padding: 8px 4px; }
QLabel#wizardRailItem[state="current"] { color: __FG_PAGE_TITLE__; font-weight: 400; }
QLabel#wizardRailItem[state="done"] { color: __FG_HINT__; }
QWidget#wizardContent { background: __BG_WINDOW__; }
QWidget#wizardActionBar { background: __BG_WINDOW__; border-top: 1px solid __BORDER_LIST__; }
QWidget#wizardActionBar QPushButton {
    min-height: 40px;
    padding: 0 24px;
    font-size: 14px;
    border-radius: __RADIUS_SM__;
}
QPushButton#wizardOption, QPushButton#wizardBrowse {
    background: __BG_OPTION__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_SM__;
    color: __FG_OPTION__;
    padding: 8px 12px;
    font-weight: 400;
    min-height: 22px;
}
QPushButton#wizardOption:hover, QPushButton#wizardBrowse:hover { border-color: __BORDER_HOVER__; color: __FG_OPTION_2__; }
QPushButton#wizardOption[selected="true"] {
    background: __ACCENT_SOFT__;
    border: 1px solid __ACCENT__;
    color: __FG_OPTION_2__;
    font-weight: 400;
}
QLabel#wizardStatus { color: __FG_HINT__; font-size: 12px; }
QLabel#wizardBullet { color: __FG_OPTION__; font-size: 13px; }
QDoubleSpinBox#wizardMemory { min-height: 30px; }

/* ---------- resources page: category chips + dense result cards ---------- */

QWidget#resourcesPage { background: transparent; }

/* The tab bar is gone: four checkable buttons switch the stacked pages. 32px tall, fully rounded,
   8px apart (the HBox in code owns the gap). The unselected label uses ACCENT_BUTTON - the accent
   shade this sheet also uses for filled buttons - because it clears 4.5:1 as text on the page
   paper, which the pure ACCENT does not (3.4:1). The checked chip already carries white text; where
   FOCUS_RING equals its own fill, the ring switches to that same white so the focus stays visible. */
QPushButton#resourceChip {
    background: transparent;
    color: __ACCENT__;
    border: 1px solid transparent;
    border-radius: 16px;
    /* 32px total including the 1px border: the 16px radius is then exactly half the height and Qt
       paints the pill. At the bare font height (19px) the radius was larger than half the button,
       and Qt silently fell back to a square fill - the square green block the user saw. */
    min-height: 30px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 400;
}
QPushButton#resourceChip:hover { background: __ACCENT_TINT__; border-radius: 16px; }
QPushButton#resourceChip:checked {
    background: __ACCENT_BUTTON__;
    color: __FG_SELECTED__;
    border-color: __ACCENT_BUTTON__;
    border-radius: 16px;
}
QPushButton#resourceChip[keyboardFocus="true"]:focus { border-color: __FOCUS_RING__; }
QPushButton#resourceChip:checked[keyboardFocus="true"]:focus { border-color: __FG_SELECTED__; }

/* PCL field metrics: 36px tall (fixed in code), 6px radius, 1px border, 12px left padding, 13px text. */
QWidget#resourcesPage QLineEdit {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LAUNCH_FIELD__;
    border-radius: __RADIUS_SM__;
    padding: 0 12px;
    font-size: 13px;
}
QWidget#resourcesPage QComboBox {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LAUNCH_FIELD__;
    border-radius: __RADIUS_SM__;
    padding: 0 24px 0 12px;
    font-size: 13px;
}
QWidget#resourcesPage QLineEdit:hover,
QWidget#resourcesPage QComboBox:hover { border-color: __BORDER_HOVER__; }
QWidget#resourcesPage QLineEdit[keyboardFocus="true"],
QWidget#resourcesPage QComboBox[keyboardFocus="true"] { border-color: __FOCUS_RING__; }

/* Result list: the cards are painted by _ResourceRow, the view only scrolls (8px item spacing). */
QListWidget#resourceList {
    background: transparent;
    border: 1px solid transparent;
    padding: 0;
    outline: none;
}
QListWidget#resourceList::item {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}
QListWidget#resourceList[keyboardFocus="true"] { border-color: __FOCUS_RING__; }

/* Install button inside a card: secondary look, compact. */
QPushButton#rowInstall {
    background: transparent;
    color: __FG_BUTTON_SECONDARY__;
    border: 1px solid __BORDER_BUTTON_SECONDARY__;
    border-radius: __RADIUS_SM__;
    padding: 0 16px;
    font-size: 12px;
    font-weight: 400;
}
QPushButton#rowInstall:hover {
    background: __BG_BUTTON_SECONDARY__;
    border-color: __ACCENT__;
    color: __FG_TEXT__;
}
QPushButton#rowInstall:pressed { background: __BG_BUTTON_PRESSED__; }
QPushButton#rowInstall:disabled {
    color: __FG_DISABLED__;
    border-color: __BORDER_BUTTON_SECONDARY_2__;
}
QPushButton#rowInstall[keyboardFocus="true"]:focus { border-color: __FOCUS_RING__; }

/* Inspector beside the list: full summary, dependency hints and the original actions. */
QFrame#resourceDetail {
    background: __BG_LIST__;
    border: 1px solid __BORDER_TABLE__;
    border-radius: __RADIUS_LG__;
}
QFrame#resourceDetail QLabel#title { font-size: 15px; font-weight: 600; color: __FG_TEXT__; }

/* ========================================================================== */
/* Instances: card grid and the drilled-down detail page.                     */
/* ========================================================================== */

/* ---------- the 200px game-folder rail (the instances page's first level) ----------
   A page-local column, not a second main rail. Its selected row speaks the same selection language
   the detail sidebar and the current card use: 3px accent bar on the left, accent text, pale wash.
   The row widgets inside the list items are transparent, so the item's own fill is what is seen. */
QWidget#instanceFolderRail { background: transparent; }
QListWidget#instanceFolderList {
    background: transparent;
    /* The transparent border is the focus ring's placeholder, the same shape QListWidget#sidebar uses:
       a view repaints its frame on focus, while an item's :focus pseudo-state proved unreliable. */
    border: 1px solid transparent;
    outline: none;
    padding: 0;
}
QListWidget#instanceFolderList[keyboardFocus="true"]:focus {
    border-color: __FOCUS_RING__;
}
QListWidget#instanceFolderList::item {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    /* Square: the selected row is an accent bar plus a pale wash, not a rounded pill. */
    border-radius: 0;
    padding: 0;
}
QListWidget#instanceFolderList::item:hover { background: __BG_SIDEBAR__; }
QListWidget#instanceFolderList::item:selected {
    background: __ACCENT_TINT__;
    border-left: 3px solid __ACCENT__;
}
QLabel#instanceFolderName {
    background: transparent;
    color: __FG_HINT__;
    font-size: 13px;
    font-weight: 400;
}
QLabel#instanceFolderName[active="true"] { color: __ACCENT_TEXT__; }
QLabel#instanceFolderCount {
    background: transparent;
    color: __FG_HINT__;
    font-size: 11px;
}
QLabel#instanceFolderCount[active="true"] { color: __ACCENT_TEXT__; }
/* The flat search results' summary line ("N 个结果"), the resources page's wording. */
QLabel#instanceResultCount {
    background: transparent;
    color: __FG_HINT__;
    font-size: 12px;
}
QScrollArea#instanceGroupScroll {
    background: transparent;
    border: none;
}
QWidget#instanceGroups, QWidget#instanceGroupSection,
QWidget#instanceFolderEmpty { background: transparent; }
/* The compact instance row. The 3px left border is always reserved, transparent when the row is
   neither current nor focused, so selecting a row cannot shift its text by two pixels. */
QFrame#instanceCard {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LIST__;
    border-left: 3px solid transparent;
    border-radius: __RADIUS_LG__;
}
QFrame#instanceCard:hover {
    background: __BG_LIST__;
    border-color: __ACCENT__;
}
/* The current instance speaks the detail sidebar's selection language: a 3px accent bar on the
   left plus the pale accent wash. Declared after :hover so a hover cannot repaint the bar away. */
QFrame#instanceCard[current="true"],
QFrame#instanceCard[current="true"]:hover {
    background: __ACCENT_TINT__;
    border-color: __ACCENT__;
    border-left: 3px solid __ACCENT__;
}
/* The whole row is a keyboard stop, so the ring is the row's outline, not a small child's. It stays
   gated on keyboardFocus: a mouse click focuses the row too and must not paint a ring. */
QFrame#instanceCard[keyboardFocus="true"]:focus {
    border: 2px solid __FOCUS_RING__;
    border-left: 3px solid __FOCUS_RING__;
}
QFrame#instanceCard[current="true"][keyboardFocus="true"]:focus {
    border-left: 3px solid __ACCENT__;
}
QWidget#instanceCardText { background: transparent; }
QLabel#instanceCardName {
    background: transparent;
    color: __FG_TEXT__;
    font-size: 15px;
    font-weight: 700;
}
QLabel#instanceCardMeta,
QLabel#instanceCardMetaSep,
QLabel#instanceCardCounts {
    background: transparent;
    color: __FG_HINT__;
    font-size: 12px;
}
QLabel#instanceCardIcon {
    background: transparent;
    border-radius: __RADIUS_SM__;
}
/* 使用 is the row's primary action: it keeps the base accent fill and states only its metrics. */
QPushButton#instanceCardUse {
    padding: 0 12px;
    font-size: 12px;
}
/* 管理 stays the quiet outline the whole card used to draw for it. */
QPushButton#instanceCardManage {
    background: transparent;
    color: __FG_BUTTON_SECONDARY__;
    border: 1px solid __BORDER_BUTTON_SECONDARY__;
    border-radius: __RADIUS_SM__;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 400;
}
QPushButton#instanceCardManage:hover {
    border-color: __ACCENT__;
    color: __FG_TEXT__;
}
QPushButton#instanceCardManage[keyboardFocus="true"]:focus {
    background: transparent;
    border-color: __FOCUS_RING__;
    color: __FG_TEXT__;
}

QWidget#instanceBrowser, QWidget#instanceDetailPage, QWidget#instanceContent,
QWidget#instanceNavBody, QWidget#instanceContentStack { background: transparent; }
QScrollArea#instanceNavScroll,
QScrollArea#instanceContentScroll {
    background: transparent;
    border: none;
}
QPushButton#backButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: __RADIUS_SM__;
    color: __FG_HINT__;
    font-weight: 400;
    padding: 4px 8px;
    text-align: left;
}
QPushButton#backButton:hover { color: __FG_TEXT__; background: __BG_SIDEBAR__; }
QPushButton#backButton[keyboardFocus="true"]:focus { border-color: __FOCUS_RING__; }

QPushButton#instanceNavItem {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    /* Square: the selected row is a 3px accent bar plus a very pale accent wash, not a rounded pill.
       Same language as the main rail's selection, without the pill silhouette. */
    border-radius: 0;
    padding: 0;
    text-align: left;
}
QPushButton#instanceNavItem:hover { background: __BG_SIDEBAR__; }
QPushButton#instanceNavItem:checked {
    background: __ACCENT_TINT__;
    border-left: 3px solid __ACCENT__;
}
QPushButton#instanceNavItem[keyboardFocus="true"]:focus {
    background: __BG_SIDEBAR__;
    border-left: 3px solid __FOCUS_RING__;
}
QPushButton#instanceNavItem:hover QLabel#instanceNavLabel { color: __FG_TEXT__; }
QLabel#instanceNavLabel {
    background: transparent;
    color: __FG_HINT__;
    font-size: 13px;
    font-weight: 400;
}
QLabel#instanceNavLabel[active="true"] {
    color: __ACCENT_TEXT__;
    font-weight: 400;
}
QLabel#instanceNavIcon { background: transparent; }
QLabel#instanceNavBadge {
    background: __BG_SIDEBAR__;
    border-radius: 9px;
    color: __FG_HINT__;
    font-size: 11px;
    padding: 0 4px;
}
QLabel#instanceNavBadge[active="true"] {
    background: __ACCENT_SOFT__;
    color: __ACCENT_TEXT__;
}
QLabel#instanceNavGroup {
    color: __FG_HINT__;
    font-size: 11px;
    padding: 0 12px;
}
QFrame#instanceNavSeparator {
    background: __BORDER_LIST__;
    border: none;
}

QWidget#instanceCard {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_LG__;
}
QLabel#instanceCardTitle {
    background: transparent;
    color: __FG_TEXT__;
    font-size: 15px;
    font-weight: 700;
}
QPlainTextEdit#instanceLogView {
    background: __BG_LIST_2__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_SM__;
    color: __FG_TEXT__;
    padding: 8px;
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 12px;
    selection-background-color: __ACCENT_SEL__;
    selection-color: __ACCENT_SEL_TEXT__;
}

/* ---------- tools page: the 联机 tab ---------- */

QWidget#toolsPage QLabel#toolsPageTitle {
    color: __FG_PAGE_TITLE__;
    font-size: 20px;
    font-weight: 600;
}

QWidget#toolsPage QTabWidget::pane {
    background: transparent;
    border: none;
    border-top: 1px solid __BORDER_TABLE__;
}
QWidget#toolsPage QTabBar::tab {
    padding: 4px 16px;
    font-size: 13px;
}

QFrame#toolsBanner, QFrame#toolsInfoPanel {
    background: __ACCENT_TINT__;
    border: 1px solid __ACCENT_SOFT__;
    border-radius: __RADIUS_LG__;
}
QLabel#toolsBannerText { color: __FG_TEXT__; font-size: 12px; }

QFrame#toolsInnerCard, QFrame#toolsRow, QFrame#toolsStepCard, QFrame#toolsMemberPanel {
    background: __BG_SECTION__;
    border: 1px solid __BORDER_TABLE__;
    border-radius: __RADIUS_LG__;
}
QFrame#toolsRoomCode {
    background: __ACCENT_TINT__;
    border: 1px solid __ACCENT_SOFT__;
    border-radius: __RADIUS_LG__;
}
QFrame#toolsMemberRow {
    background: transparent;
    border: none;
    border-bottom: 1px solid __BORDER_TABLE__;
}
QFrame#toolsFooter {
    background: transparent;
    border: none;
    border-top: 1px solid __BORDER_TABLE__;
}
QLabel#toolsFooterText { color: __FG_HINT__; font-size: 12px; }
/* 停用联机功能: a quiet text link that is a real button. The 1px transparent border is the focus
   ring's placeholder (the same recipe #secondaryButton uses), so focusing it cannot move the footer. */
QPushButton#toolsFooterLink {
    background: transparent;
    border: 1px solid transparent;
    border-radius: __RADIUS_SM__;
    color: __FG_HINT__;
    padding: 0 4px;
    font-size: 12px;
    font-weight: 400;
}
QPushButton#toolsFooterLink:hover { color: __FG_TEXT__; border-color: __BORDER_HOVER__; }
QPushButton#toolsFooterLink:pressed { color: __ACCENT__; }
QPushButton#toolsFooterLink[keyboardFocus="true"] { color: __FG_TEXT__; border-color: __FOCUS_RING__; }

QLabel#toolsRowTitle { color: __FG_TEXT__; font-size: 13px; }
QLabel#toolsStepText { color: __FG_TEXT__; font-size: 13px; }
QLabel#toolsCenterTitle { color: __FG_TEXT__; font-size: 16px; font-weight: 600; }
QLabel#toolsRoomCodeText {
    color: __FG_TEXT__;
    font-family: "Cascadia Mono", "Consolas", "Microsoft YaHei UI", monospace;
    font-size: 24px;
    font-weight: 600;
}
QLabel#toolsAddressText {
    color: __FG_TEXT__;
    font-family: "Cascadia Mono", "Consolas", "Microsoft YaHei UI", monospace;
    font-size: 16px;
    font-weight: 600;
}
QLabel#toolsMemberName { color: __FG_TEXT__; font-size: 13px; }
QLabel#toolsHostBadge {
    background: __ACCENT_SOFT__;
    color: __ACCENT_TEXT__;
    border-radius: __RADIUS_XS__;
    padding: 0 4px;
    font-size: 11px;
}
QLabel#toolsOnlineDot { color: __ACCENT__; font-size: 10px; }
QLabel#toolsOnlineText { color: __FG_HINT__; font-size: 12px; }

QLabel#toolsDifficultyText { color: __FG_HINT__; font-size: 13px; }
QLabel#toolsDifficultyPill {
    background: __BG_SECTION__;
    color: __FG_TEXT__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_XS__;
    padding: 0 8px;
    font-size: 12px;
}
QLabel#toolsDifficultyPill[level="tough"] {
    color: __FG_STATUS_WARNING__;
    border-color: __FG_STATUS_WARNING__;
}

QWidget#toolsPage QPushButton#toolsIconButton {
    background: __BG_LIST__;
    color: __FG_BUTTON_SECONDARY__;
    border: 1px solid __BORDER_BUTTON_SECONDARY__;
    border-radius: __RADIUS_SM__;
    padding: 0;
    font-size: 16px;
}
QWidget#toolsPage QPushButton#toolsIconButton:hover {
    background: __BG_BUTTON_SECONDARY__;
    border-color: __ACCENT__;
    color: __FG_TEXT__;
}
QWidget#toolsPage QPushButton#toolsIconButton:pressed {
    background: __BG_BUTTON_PRESSED__;
}
QWidget#toolsPage QPushButton#toolsIconButton:disabled {
    background: __BG_DISABLED__;
    color: __FG_DISABLED__;
    border-color: __BORDER_BUTTON_SECONDARY_2__;
}
QWidget#toolsPage QPushButton#toolsIconButton[keyboardFocus="true"] {
    border-color: __FOCUS_RING__;
}

QWidget#toolsPage QPushButton#toolsDisclosure {
    background: transparent;
    color: __FG_TEXT__;
    border: 1px solid transparent;
    border-radius: __RADIUS_SM__;
    padding: 4px 0;
    text-align: left;
    font-size: 13px;
}
QWidget#toolsPage QPushButton#toolsDisclosure:hover {
    color: __ACCENT_TEXT__;
}
QWidget#toolsPage QPushButton#toolsDisclosure[keyboardFocus="true"] {
    border-color: __FOCUS_RING__;
}
QWidget#toolsPage QLabel#toolsDisclosureText {
    color: __FG_TEXT__;
    font-size: 13px;
}
QWidget#toolsPage QLabel#toolsDisclosureArrow {
    color: __FG_HINT__;
    font-size: 12px;
}

QWidget#toolsPage QTabWidget[keyboardFocus="true"]::pane {
    border: 1px solid __FOCUS_RING__;
}

QTabBar {
    border: 1px solid transparent;
    border-radius: __RADIUS_SM__;
}

QTabBar[keyboardFocus="true"] {
    border-color: __FOCUS_RING__;
}
